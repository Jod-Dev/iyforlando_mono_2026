# IYF Orlando Platform 2026 - Environment Variables Template
# 
# INSTRUCCIONES:
# 1. Copia este archivo a .env
# 2. Completa los valores con tus credenciales de Supabase
# 3. NUNCA commitees el archivo .env (ya está en .gitignore)

# ============================================
# SUPABASE CONFIGURATION
# ============================================

# URL de tu proyecto Supabase
# Ejemplo: https://xxxxxxxxxxxxx.supabase.co
SUPABASE_URL=your_supabase_project_url_here

# Anon Key (Public Key) - Seguro para usar en frontend
# Esta key se expone en el frontend, pero RLS protege los datos
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Service Role Key (Secret Key) - NUNCA usar en frontend
# Solo usar en Edge Functions o backend
# ⚠️ NUNCA commitees esta key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# ============================================
# APPLICATION CONFIGURATION
# ============================================

# Entorno de la aplicación
NODE_ENV=development

# URL de la API (si necesitas una diferente a Supabase)
# API_URL=http://localhost:3000

# ============================================
# OPTIONAL: EMAIL SERVICE (Si usas servicio externo)
# ============================================

# SENDGRID_API_KEY=your_sendgrid_key_here
# MAILGUN_API_KEY=your_mailgun_key_here

# ============================================
# OPTIONAL: MONITORING (Sentry, LogRocket, etc.)
# ============================================

# SENTRY_DSN=your_sentry_dsn_here
# LOGROCKET_ID=your_logrocket_id_here
